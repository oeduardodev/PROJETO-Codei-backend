# Endereço e porta do servidor
HOST=127.0.0.1
PORT=3333

# Chave de criptografia da aplicação (gerar com: node ace generate:key)
APP_KEY=your_app_key_here

# Nome da aplicação
APP_NAME=YourAppName

# Disco padrão para uploads (local, s3, etc.)
DRIVE_DISK=local

# Ambiente da aplicação (development, production, etc.)
NODE_ENV=development

# Configuração do banco de dados (sqlite, mysql, postgres, etc.)
DB_CONNECTION=sqlite

# Cloudinary - serviço de armazenamento de mídia (gerar em sua conta na cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternativa recomendada (sobrepõe as variáveis acima quando definida):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
FRONTEND_URL=http://localhost:4200

# Segurança / deploy
# Lista separada por virgula com as origens permitidas para CORS.
ALLOWED_ORIGINS=http://localhost:4200

# Em producao, deixe true quando o provedor Postgres tiver certificado valido.
# Use false somente se seu provedor exigir explicitamente.
DB_SSL_REJECT_UNAUTHORIZED=true
